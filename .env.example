# Scam Saathi — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets.

# --- Sarvam AI API Key (required for live AI analysis) ---
# When set, the application uses live AI analysis via Sarvam sarvam-105b.
# When empty or missing, the app runs in Demo Mode (rule-based analysis).
# Get your key at: https://indus.sarvam.ai/key-management
SARVAM_API_KEY=

# --- Optional: Sarvam Model Selection ---
# Default: sarvam-105b (flagship model with Indian language support)
SARVAM_MODEL=sarvam-105b
